# CI Environment Configuration
# This file contains environment variables needed for CI testing

# Django settings
DEBUG=True
SECRET_KEY=test-secret-key-for-ci-only

# Database configuration for CI (MySQL)
DB_NAME=dmoj
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_SQL_MODE=STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# Static files configuration
STATIC_ROOT=/tmp/static
COMPRESS_OUTPUT_DIR=cache

# Email backend for testing
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cache configuration (locmem for CI)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Site configuration
SITE_NAME=DMOJ
SITE_LONG_NAME=DMOJ: Modern Online Judge
SITE_ADMIN_EMAIL=admin@example.com

# Basic feature flags
ENABLE_FTS=True
USE_I18N=True

# Disable external services for CI
EVENT_DAEMON_USE=False
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
